# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - COPIAR A .env Y COMPLETAR VALORES
# ==============================================================================

# Base de Datos PostgreSQL
DB_NAME=sistema_matriculas_sleep
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_CLIENT_ENCODING=utf8
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=10.0

# Seguridad JWT
SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Servicio de Correo SMTP
EMAIL_REMITENTE=tu_correo@gmail.com
PASSWORD_APP=tu_password_de_aplicacion
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Dominio Frontend y Orígenes CORS Permitidos (separados por coma)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# Almacenamiento de Objetos (S3 / Cloudflare R2 / MinIO / Local)
STORAGE_PROVIDER=local
# Para S3, Cloudflare R2 o MinIO descomentar y completar:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=tu_access_key_id
# S3_SECRET_ACCESS_KEY=tu_secret_access_key
# S3_BUCKET_NAME=matriculas-documentos
# S3_REGION_NAME=auto
